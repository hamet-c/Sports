ODDS_API_KEY=
# DATABASE_URL=postgresql://user:pass@localhost/nba_props

# Turso (hosted libSQL). Opt-in: the engine only uses Turso when USE_TURSO
# is truthy AND both vars below are set. Leave USE_TURSO unset for local
# development — the sqlite+libsql dialect does not install on Windows /
# Python 3.14 (CI pins Python 3.12), and heavy scripts (train / backtest /
# diagnose) should never run over the network. CI sets all three from repo
# secrets. Get credentials from the https://turso.  tech dashboard.
USE_TURSO=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

EDGE_THRESHOLD=0.05
# Optional asymmetric threshold for OVER recs. Set higher than EDGE_THRESHOLD
# to demand more evidence on the OVER side (used when the mean head is biased
# high — see NEXT_SESSION.md Phase 5.5).
EDGE_THRESHOLD_OVER=0.05
LOG_LEVEL=INFO
